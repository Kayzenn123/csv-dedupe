#!/usr/bin/env bash
# csv-dedupe — remove duplicate rows from a CSV file (or stdin) and print a
# human-readable duplicate report (or JSON with --json). Zero dependencies:
# bash + any POSIX awk (gawk, mawk, busybox awk).
set -euo pipefail

VERSION="1.0.0"
PROG="csv-dedupe"

usage() {
  cat <<'EOF'
Usage: csv-dedupe [OPTIONS] [FILE|-]

Remove duplicate rows from a CSV file and print a duplicate report.
Reads FILE, or standard input when FILE is "-" or omitted.

Options:
  -k, --key COLS        key columns: header names or 1-based indexes,
                       comma-separated (default: whole row)
      --keep MODE       keep "first" (default) or "last" occurrence
  -n, --normalize       fold text before comparing: lowercase, trim and
                       collapse whitespace (output rows are unchanged)
      --no-header       input has no header row; --key uses 1-based indexes
  -d, --delimiter C     field delimiter (default: auto-detect , ; TAB |)
  -o, --output FILE    write deduplicated CSV to FILE (must not exist
                       unless --force); the report is still printed
      --print          print deduplicated CSV to stdout instead of the report
  -q, --quiet          suppress the report
      --in-place       rewrite the input file (requires --yes; not for stdin)
      --yes            confirm --in-place
      --force          allow --output to overwrite an existing file
      --json           print the report as JSON instead of a table
      --no-color       disable colors even on a TTY
      --version        print version and exit
  -h, --help           print this help and exit

Exit codes: 0 ok, 1 runtime error, 2 bad usage.

Examples:
  csv-dedupe orders.csv
  csv-dedupe --key email --normalize contacts.csv -o contacts-clean.csv
  cat data.csv | csv-dedupe --json --key 1,3
EOF
}

# ---------------- argument parsing ----------------
KEY_SPEC="" KEEP="first" NORMALIZE=0 NO_HEADER=0 DELIM="auto"
OUTPUT="" PRINT=0 QUIET=0 INPLACE=0 YES=0 FORCE=0 JSON=0 NOCOLOR=0 INPUT=""

die() { # $1=code $2=message
  printf '%s: error: %s\n' "$PROG" "$2" >&2
  exit "$1"
}

while [ $# -gt 0 ]; do
  case "$1" in
    -k|--key)       [ $# -ge 2 ] || die 2 "--key needs a value"; KEY_SPEC="$2"; shift 2;;
    --keep)         [ $# -ge 2 ] || die 2 "--keep needs a value"; KEEP="$2"; shift 2;;
    -n|--normalize) NORMALIZE=1; shift;;
    --no-header)    NO_HEADER=1; shift;;
    -d|--delimiter) [ $# -ge 2 ] || die 2 "--delimiter needs a value"; DELIM="$2"; shift 2;;
    -o|--output)    [ $# -ge 2 ] || die 2 "--output needs a value"; OUTPUT="$2"; shift 2;;
    --print)        PRINT=1; shift;;
    -q|--quiet)     QUIET=1; shift;;
    --in-place)     INPLACE=1; shift;;
    --yes)          YES=1; shift;;
    --force)        FORCE=1; shift;;
    --json)         JSON=1; shift;;
    --no-color)     NOCOLOR=1; shift;;
    --version)      printf '%s %s\n' "$PROG" "$VERSION"; exit 0;;
    -h|--help)      usage; exit 0;;
    --)             shift; [ $# -le 1 ] || die 2 "too many arguments"; [ $# -eq 0 ] || INPUT="$1"; break;;
    -)              [ -z "$INPUT" ] || die 2 "too many arguments"; INPUT="-"; shift;;
    -*)             die 2 "unknown option: $1 (see --help)";;
    *)              [ -z "$INPUT" ] || die 2 "too many arguments"; INPUT="$1"; shift;;
  esac
done

[ "$KEEP" = "first" ] || [ "$KEEP" = "last" ] || die 2 "--keep must be first|last"
[ ${#DELIM} -eq 1 ] || [ "$DELIM" = "auto" ] || die 2 "--delimiter must be a single character"
[ "$PRINT" -eq 0 ] || [ -z "$OUTPUT" ] || die 2 "--print cannot be combined with --output"
[ "$INPLACE" -eq 0 ] || [ -z "$OUTPUT" ] || die 2 "--in-place cannot be combined with --output"
[ "$INPLACE" -eq 0 ] || [ "$YES" -eq 1 ] || die 2 "--in-place requires --yes"
if [ "$INPLACE" -eq 1 ]; then
  [ -n "$INPUT" ] && [ "$INPUT" != "-" ] || die 2 "--in-place needs a real input file, not stdin"
fi
if [ -n "$OUTPUT" ] && [ -n "$INPUT" ] && [ "$INPUT" != "-" ] && [ -e "$OUTPUT" ] && [ "$OUTPUT" -ef "$INPUT" ]; then
  die 2 "--output is the same file as input; use --in-place --yes instead"
fi
if [ -n "$OUTPUT" ] && [ -e "$OUTPUT" ] && [ "$FORCE" -eq 0 ]; then
  die 1 "output file exists: $OUTPUT (use --force to overwrite)"
fi
if [ -n "$INPUT" ] && [ "$INPUT" != "-" ] && [ ! -f "$INPUT" ]; then
  die 1 "input file not found: $INPUT"
fi

# colors only on a TTY, honoring NO_COLOR
if [ -t 1 ] && [ "$NOCOLOR" -eq 0 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
else
  BOLD=""; DIM=""; RESET=""
fi

TMPDIR_WORK="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_WORK"' EXIT
STATS="$TMPDIR_WORK/stats"
KEPT="$TMPDIR_WORK/kept.csv"
AWK_PROG="$TMPDIR_WORK/prog.awk"

# ---------------- core: embedded awk ----------------
# Writes kept rows to KEPT, and a machine-readable stats file for the report.
cat > "$AWK_PROG" <<'AWKEOF'
function die_awk(msg) { print "csv-dedupe: error: " msg > "/dev/stderr"; exit 1 }

# splitcsv: parse one CSV line into f[1..n]; quotes unwrapped, "" -> ".
# Returns field count. (Caller strips trailing \r first.)
function splitcsv(line, d, f,   n,i,c,inq,cur,nxt) {
  n = 0; cur = ""; inq = 0
  for (i = 1; i <= length(line); i++) {
    c = substr(line, i, 1)
    if (inq) {
      if (c == "\"") {
        nxt = substr(line, i + 1, 1)
        if (nxt == "\"") { cur = cur "\""; i++ } else { inq = 0 }
      } else { cur = cur c }
    } else if (c == "\"" && cur == "") {
      inq = 1
    } else if (c == d) {
      n++; f[n] = cur; cur = ""
    } else { cur = cur c }
  }
  n++; f[n] = cur
  return n
}

function fold(s) {
  s = tolower(s)
  gsub(/^ +| +$/, "", s)
  gsub(/  +/, " ", s)
  return s
}

function buildkey(nf, f,   i, k, v) {
  k = ""; dkey = ""
  for (i = 1; i <= nkey; i++) {
    v = f[kidx[i]]
    if (normalize) v = fold(v)
    k = k v SEP
    dkey = dkey (i > 1 ? ", " : "") f[kidx[i]]
  }
  DISPKEY = dkey                       # human-readable key for samples
  return k
}

function resolve_keys(nf, f,   i, t, j, found, hn, tn) {
  nkey = 0
  if (nspec == 0) { for (i = 1; i <= nf; i++) { nkey++; kidx[nkey] = i }; return }
  for (i = 1; i <= nspec; i++) {
    t = kspec[i]
    if (t ~ /^[0-9]+$/) {
      if (t + 0 < 1 || t + 0 > nf)
        die_awk("--key index out of range: " t " (have " nf " columns)")
      nkey++; kidx[nkey] = t + 0
    } else {
      if (no_header) die_awk("--key names need a header row (use indexes with --no-header)")
      found = 0
      for (j = 1; j <= nf; j++) {
        hn = f[j]; gsub(/^ +| +$/, "", hn)
        tn = t;    gsub(/^ +| +$/, "", tn)
        if (hn == tn) { nkey++; kidx[nkey] = j; found = 1; break }
      }
      if (!found) die_awk("unknown --key column: " t)
    }
  }
}

function sniff(line,   cands, best, bestn, n, tmp, i) {
  cands[1] = ","; cands[2] = ";"; cands[3] = sprintf("%c", 9); cands[4] = "|"
  best = ","; bestn = 0
  for (i = 1; i <= 4; i++) {
    n = splitcsv(line, cands[i], tmp)
    if (n > bestn) { bestn = n; best = cands[i] }
  }
  return best
}

BEGIN {
  SEP = sprintf("%c", 31)          # unit separator for key joining
  nkey = 0
  if (key_spec != "") {
    nspec = split(key_spec, ktok, ",")
    for (i = 1; i <= nspec; i++) {
      t = ktok[i]; gsub(/^ +| +$/, "", t)
      if (t == "") die_awk("empty entry in --key")
      kspec[i] = t
    }
  } else { nspec = 0 }
  header_seen = 0; ncols = 0; total = 0; nsamp = 0
}

{
  line = $0
  sub(/\r$/, "", line)                       # tolerate CRLF
  if (!header_seen && total == 0 && line == "") next   # skip leading blank line
  if (!header_seen) {
    d = (delim == "auto") ? sniff(line) : delim
    DELIM = d
    nf = splitcsv(line, d, f)
    if (nf < 1) die_awk("could not parse first row")
    ncols = nf
    for (i = 1; i <= nf; i++) { hdr[i] = f[i]; colnames = colnames (i > 1 ? SEP : "") f[i] }
    resolve_keys(nf, f)
    if (!no_header) { print line > kept_file; header_seen = 1; next }
    header_seen = 1
    # fall through: first line is data when --no-header
  }
  nf = splitcsv(line, DELIM, f)
  if (nf != ncols)
    die_awk("row " NR " has " nf " fields, expected " ncols)
  total++
  key = buildkey(nf, f)
  cnt[key]++
  if (!(key in firstline)) firstline[key] = line
  if (keep == "first") {
    if (!(key in seen)) { seen[key] = 1; print line > kept_file }
  } else {
    lastline[key] = line
    lastord[key] = total
    rowkey[total] = key
  }
  if (cnt[key] >= 2) {
    slot = 0
    for (s = 1; s <= nsamp; s++) if (sampraw[s] == key) { slot = s; break }
    if (slot == 0 && nsamp < 5) {
      nsamp++; slot = nsamp
      sampraw[slot] = key
      sampkey[slot] = DISPKEY; sampline1[slot] = firstline[key]
    }
    if (slot > 0) { sampdup[slot] = line; sampcount[slot] = cnt[key] }
  }
}

END {
  if (NR == 0 || (total == 0 && !header_seen)) die_awk("empty input: no rows to process")
  if (keep == "last") {
    for (t = 1; t <= total; t++) {
      k = rowkey[t]
      if (lastord[k] == t) print lastline[k] > kept_file
    }
  }
  h1 = 0; h2 = 0; h3p = 0; nunique = 0
  for (k in cnt) { nunique++; c = cnt[k]; if (c == 1) h1++; else if (c == 2) h2++; else h3p++ }
  dups = total - nunique
  printf "total=%d\nkept=%d\ndups=%d\nnunique=%d\nh1=%d\nh2=%d\nh3p=%d\nncols=%d\n",
         total, nunique, dups, nunique, h1, h2, h3p, ncols > stats_file
  printf "delim=%s\n", (DELIM == sprintf("%c", 9) ? "TAB" : DELIM) > stats_file
  printf "colnames=%s\n", colnames > stats_file
  printf "keep=%s\nnormalize=%d\nkeydesc=%s\n", keep, normalize, \
         (nspec == 0 ? "whole row" : key_spec) > stats_file
  printf "nsamp=%d\n", nsamp > stats_file
  for (s = 1; s <= nsamp; s++) {
    a = sampkey[s]; b = sampline1[s]; c = sampdup[s]
    gsub(/[\n\r]/, " ", a); gsub(/[\n\r]/, " ", b); gsub(/[\n\r]/, " ", c)
    printf "samp=%s\034%s\034%d\034%s\034%s\n", s, a, sampcount[s], b, c > stats_file
  }
}
AWKEOF

# run awk against file or stdin; propagate a non-zero status as-is
set +e
if [ -n "$INPUT" ] && [ "$INPUT" != "-" ]; then
  awk -v key_spec="$KEY_SPEC" -v keep="$KEEP" -v normalize="$NORMALIZE" \
      -v no_header="$NO_HEADER" -v delim="$DELIM" \
      -v stats_file="$STATS" -v kept_file="$KEPT" \
      -f "$AWK_PROG" "$INPUT"
else
  awk -v key_spec="$KEY_SPEC" -v keep="$KEEP" -v normalize="$NORMALIZE" \
      -v no_header="$NO_HEADER" -v delim="$DELIM" \
      -v stats_file="$STATS" -v kept_file="$KEPT" \
      -f "$AWK_PROG"
fi
awk_status=$?
set -e
[ "$awk_status" -eq 0 ] || exit "$awk_status"

# ---------------- read stats ----------------
total=""; dups=""; nunique=""; h1=""; h2=""; h3p=""; ncols=""
delim=""; colnames=""; keep=""; normalize=""; keydesc=""; nsamp=0
SAMP_KEYS=(); SAMP_COUNTS=(); SAMP_L1=(); SAMP_L2=()
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    total=*)   total="${line#total=}";;
    dups=*)    dups="${line#dups=}";;
    nunique=*) nunique="${line#nunique=}";;
    h1=*)      h1="${line#h1=}";;
    h2=*)      h2="${line#h2=}";;
    h3p=*)     h3p="${line#h3p=}";;
    ncols=*)   ncols="${line#ncols=}";;
    delim=*)   delim="${line#delim=}";;
    colnames=*) colnames="${line#colnames=}";;
    keep=*)    keep="${line#keep=}";;
    normalize=*) normalize="${line#normalize=}";;
    keydesc=*) keydesc="${line#keydesc=}";;
    nsamp=*)   nsamp="${line#nsamp=}";;
    samp=*)
      rest="${line#samp=}"
      IFS=$'\034' read -r _idx skey scount sl1 sl2 <<< "$rest"
      SAMP_KEYS+=("$skey"); SAMP_COUNTS+=("$scount")
      SAMP_L1+=("$sl1"); SAMP_L2+=("$sl2");;
  esac
done < "$STATS"

[ -n "$total" ] || die 1 "internal error: stats not produced"

pretty_cols="$(printf '%s' "$colnames" | tr '\037' ', ')"
input_label="${INPUT:-stdin}"
[ "$input_label" = "-" ] && input_label="stdin"

# ---------------- output actions ----------------
if [ -n "$OUTPUT" ]; then
  cp "$KEPT" "$OUTPUT"
elif [ "$INPLACE" -eq 1 ]; then
  cp "$KEPT" "$INPUT"
fi

if [ "$PRINT" -eq 1 ]; then
  cat "$KEPT"
  exit 0
fi

[ "$QUIET" -eq 1 ] && exit 0

# ---------------- report ----------------
rate="$(awk -v t="$total" -v d="$dups" 'BEGIN{printf "%.2f", (t>0? d/t*100 : 0)}')"

if [ "$JSON" -eq 1 ]; then
  json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
    printf '%s' "$s"
  }
  {
    printf '{\n'
    printf '  "tool": "csv-dedupe",\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "input": "%s",\n' "$(json_escape "$input_label")"
    printf '  "delimiter": "%s",\n' "$(json_escape "$delim")"
    printf '  "columns": ['
    first=1
    while IFS= read -r c || [ -n "$c" ]; do
      [ -n "$c" ] || continue
      [ "$first" -eq 1 ] || printf ', '
      printf '"%s"' "$(json_escape "$c")"; first=0
    done < <(printf '%s' "$colnames" | tr '\037' '\n')
    printf '],\n'
    printf '  "key": "%s",\n' "$(json_escape "$keydesc")"
    printf '  "keep": "%s",\n' "$(json_escape "$keep")"
    printf '  "normalize": %s,\n' "$([ "$normalize" -eq 1 ] && echo true || echo false)"
    printf '  "rows": %s,\n' "$total"
    printf '  "unique": %s,\n' "$nunique"
    printf '  "duplicates": %s,\n' "$dups"
    printf '  "duplicate_rate": %s,\n' "$(awk -v t="$total" -v d="$dups" 'BEGIN{printf "%.4f", (t>0? d/t : 0)}')"
    printf '  "key_histogram": {"1": %s, "2": %s, "3plus": %s},\n' "$h1" "$h2" "$h3p"
    printf '  "duplicate_samples": ['
    for i in "${!SAMP_KEYS[@]}"; do
      [ "$i" -eq 0 ] || printf ', '
      printf '\n    {"key": "%s", "count": %s, "first_line": "%s", "duplicate_line": "%s"}' \
        "$(json_escape "${SAMP_KEYS[$i]}")" "${SAMP_COUNTS[$i]}" \
        "$(json_escape "${SAMP_L1[$i]}")" "$(json_escape "${SAMP_L2[$i]}")"
    done
    [ "${#SAMP_KEYS[@]}" -eq 0 ] || printf '\n  '
    printf ']\n}\n'
  }
  exit 0
fi

# human table
printf '%s%s%s duplicate report\n' "$BOLD" "$PROG" "$RESET"
printf '  %-12s: %s\n' "input" "$input_label"
printf '  %-12s: %s\n' "delimiter" "$delim"
printf '  %-12s: %s (%s)\n' "columns" "$ncols" "$pretty_cols"
printf '  %-12s: %s\n' "key" "$keydesc"
printf '  %-12s: %s\n' "keep" "$keep"
printf '  %-12s: %s\n' "normalize" "$([ "$normalize" -eq 1 ] && echo yes || echo no)"
printf '  %-12s: %s\n' "rows" "$total"
printf '  %-12s: %s\n' "unique" "$nunique"
printf '  %-12s: %s (%s%%)\n' "duplicates" "$dups" "$rate"
printf '  %-12s: 1x: %s keys, 2x: %s keys, 3x+: %s keys\n' "key histogram" "$h1" "$h2" "$h3p"
if [ "${#SAMP_KEYS[@]}" -gt 0 ]; then
  printf '  %sduplicate samples (up to 5):%s\n' "$DIM" "$RESET"
  for i in "${!SAMP_KEYS[@]}"; do
    printf '    [%sx] key=%s\n' "${SAMP_COUNTS[$i]}" "${SAMP_KEYS[$i]}"
    printf '      first: %s\n' "${SAMP_L1[$i]}"
    printf '      dup:   %s\n' "${SAMP_L2[$i]}"
  done
fi
